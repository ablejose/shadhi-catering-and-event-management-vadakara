# OPTIONAL. Everything the site needs lives in event.config.ts / events/<slug>.config.ts.
# These only exist so a deployment can override without a code change.

# WhatsApp number in wa.me format: country code + number, digits only (no + or spaces).
# Overrides contact.whatsapp from the event config.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Search Console verification token (URL-prefix property, "HTML tag" method).
# Paste ONLY the content value, e.g. <meta name="google-site-verification" content="AbC123..."> -> AbC123...
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
